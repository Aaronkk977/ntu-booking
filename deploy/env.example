# Settings for deploy/run.sh and deploy/setup.sh. Copied to deploy/env (chmod 600, not in git).

# Port on 127.0.0.1. Other people on the same workstation can reach it too, so pick something not in use
# (the web app still needs a login for everything).
PORT=8765

# Leave both empty for a quick tunnel (a new https://*.trycloudflare.com address every restart, sent to
# everybody on Discord). For a fixed address: a domain on Cloudflare, Zero Trust → Networks → Tunnels →
# create a tunnel, route your hostname to http://127.0.0.1:<PORT>, and paste its token and the address here.
TUNNEL_TOKEN=
PUBLIC_URL=

# With a quick tunnel: a static page that forwards to the current address, rewritten on every change, so
# people can bookmark one address. On the CSIE workstations ~/htdocs is served as
# https://www.csie.ntu.edu.tw/~<account>/ (REDIRECT_URL is what the Discord message points people to).
#REDIRECT_FILE=~/htdocs/nb/index.html
#REDIRECT_URL=https://www.csie.ntu.edu.tw/~b12345678/nb/

# The home directory has a quota; the headless Chromium is about 100 MB. /tmp2 is bigger but gets cleaned.
#PLAYWRIGHT_BROWSERS_PATH=/tmp2/your-account/ms-playwright
